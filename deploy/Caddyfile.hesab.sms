moshtarakin.filmjadiid.ir {
    encode zstd gzip
    reverse_proxy customer-portal:8091
}

hesab.filmjadiid.ir {
    encode zstd gzip

    @old_customer_portal path /my /my/*
    redir @old_customer_portal https://moshtarakin.filmjadiid.ir 308

    handle_path /sms-gateway/* {
        reverse_proxy sms-gateway:8090
    }

    handle {
        reverse_proxy app:8000
    }
}
