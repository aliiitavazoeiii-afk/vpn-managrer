{
  "manifest_version": 3,
  "name": "Hesab → Google Messages",
  "version": "0.2.1",
  "description": "Guarded one-click sending through paired Google Messages Web, with Hesab backend reconciliation; no Android gateway.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://messages.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hesab.filmjadiid.ir/*"
      ],
      "js": [
        "hesab.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hesab → Google Messages"
  }
}
